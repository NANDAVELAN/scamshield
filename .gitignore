# ==============================================================================
# ScamShield Git Ignore Rules
# ==============================================================================

# Environment files
.env
.env.*
!.env.example

# Python virtual environments & interpreters
.venv/
venv/
ENV/
env/
.Python

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python packaging & builds
build/
dist/
*.egg-info/
*.egg

# Test coverage & reports
.coverage
htmlcov/
coverage.xml
*.cover
harness/harness_report.json
harness/harness_report.html
report.html
report.json

# Logs & temporary files
*.log
logs/
*.tmp
*.temp

# Local databases
*.db
*.sqlite
*.sqlite3

# Node & frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Android / Mobile build outputs
.gradle/
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/capacitor-cordova-android-plugins/build/
local.properties
*.apk
*.aab
*.ap_

# Keystores & mobile signing credentials
*.jks
*.keystore
*.p12
*.pem
*.key

# Model weights & offline artifacts
models/
*.bin
*.gguf
*.onnx

# Agent & Antigravity local state
.agent/
setup-agent-env.sh
.system_generated/

# IDE & OS specific files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini