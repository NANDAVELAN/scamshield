{
  "manifest_version": 3,
  "name": "ScamShield — AI Inbox Immune System",
  "version": "1.0.0",
  "description": "Sub-second reflex triage and multi-agent scam protection for Gmail and web navigation.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content_gmail.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamShield Protection Status"
  }
}
