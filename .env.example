# ==============================================================================
# ScamShield Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini (Primary Multimodal & Multi-Agent Engine)
# Required for full LLM multi-agent reasoning.
# Get a key from: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# ------------------------------------------------------------------------------
# TypeSafe AI / Jev (Optional System-1 Fast Reflex Gate)
# If left empty, ScamShield cascades to Gemini Flash JSON schema, then local rules.
# Get a key from: https://typesafe.ai/
# ------------------------------------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai

# ------------------------------------------------------------------------------
# Local Ollama Inference (Optional 100% Offline / Local Fallback)
# Install Ollama from: https://ollama.com/
# ------------------------------------------------------------------------------
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=ollama_chat/qwen2.5:7b

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
SCAMSHIELD_ENV=local
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,capacitor://localhost
